@baseUrl = http://localhost:8081
# Contraseña de los usuarios iniciales: la de AUTH_SEED_DEFAULT_PASSWORD en .env (no la escriba aquí si va a commitear).
@seedPassword = <AUTH_SEED_DEFAULT_PASSWORD>

### Register local user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "local.user@example.com",
  "password": "Password123",
  "fullName": "Local User"
}

### Login local user
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "userNameOrEmail": "local.user@example.com",
  "password": "Password123"
}

### Login seeded admin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "userNameOrEmail": "admin",
  "password": "{{seedPassword}}"
}

### Current user
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{accessToken}}

### Forgot password
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "userNameOrEmail": "admin"
}

### Reset password
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "userNameOrEmail": "admin",
  "token": "paste-reset-token-here",
  "newPassword": "Password123"
}

### Change password
POST {{baseUrl}}/api/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "Password123",
  "newPassword": "Password1234"
}

### List unidades de medida with JWT
GET {{baseUrl}}/api/unidades-medida
Authorization: Bearer {{accessToken}}

### Create unidad de medida with JWT
POST {{baseUrl}}/api/unidades-medida
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "codigo": "DEMO",
  "nombre": "Unidad demo",
  "decimales": 0
}
