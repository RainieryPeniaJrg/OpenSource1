# Contraseña del usuario de PostgreSQL. Solo se aplica la PRIMERA vez que se crea el volumen postgres-data:
# si se cambia después, la API no podrá conectarse. Para cambiarla hay que recrear el volumen
# (docker compose down -v, borra todos los datos) o volver a poner el valor original.
POSTGRES_PASSWORD=Change_this_postgres_password_12345

# Clave de firma del JWT (mínimo 32 caracteres aleatorios; por ejemplo: openssl rand -base64 48).
JWT_SIGNING_KEY=Change_this_local_jwt_signing_key_1234567890

# Contraseña con la que se crean los usuarios iniciales admin, supervisor y ejecutor (y los de demostración).
# Es la contraseña para iniciar sesión. Mínimo 8 caracteres con mayúscula, minúscula y dígito.
# Solo se aplica al CREAR cada usuario: si se cambia después, poner AUTH_SEED_RESET_PASSWORDS=true y reiniciar la API.
AUTH_SEED_DEFAULT_PASSWORD=Change_this_seed_password_12345

# true: al arrancar, la API vuelve a poner AUTH_SEED_DEFAULT_PASSWORD a los usuarios iniciales que tengan otra contraseña.
AUTH_SEED_RESET_PASSWORDS=false

# Puerto del host para PostgreSQL (cambiarlo si 5432 ya está ocupado)
POSTGRES_PORT=5432
