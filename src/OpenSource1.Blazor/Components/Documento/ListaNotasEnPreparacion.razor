@using OpenSource1.Application.Features.NotasCreditoVenta.Borradores.Dtos
@using OpenSource1.Blazor.Services
@inject INotaCreditoVentaApiClient NotaApiClient
@inject ILogger<ListaNotasEnPreparacion> Logger
@inject NavigationManager Nav

@* Pestaña "En preparación" de /notas-credito-venta (spec alta rápida, Parte 2): cliente, factura de origen, creado el, líneas, total
   y estado como insignia de texto; "Continuar" abre la nota y "Descartar" (CanDelete; toda nota en preparación está Abierta) pide
   confirmación. El total es la suma de las líneas tal como están (ImporteTotal de la API, sin los topes de lo que queda por acreditar
   de la factura): la columna lo dice ("Total estimado") y la nota al pie explica que el importe definitivo se fija al registrar. Los
   filtros, la página y deleteId llegan de la página como parámetros. El formulario de descarte está siempre en el árbol (PF6: también
   en la pestaña "Registradas", con SoloFormulario): un POST obsoleto o forzado recibe el mensaje real de la API; su ?ok=descartada se
   muestra en ambas pestañas. El número interno (numero) es el filtro con que llega "Ver todos" de la búsqueda global. *@
@if (ListaPreparacion.MensajeOk(Ok, "nota de crédito") is { } mensajeOk)
{
    <div class="mb-6"><ActionFeedback Type="success" Message="@mensajeOk" /></div>
}
@if (SoloFormulario)
{
    <ResumenErrores Mensaje="@error" Errores="@errores" />
    <EditForm Model="DeleteInput" FormName="delete-borrador-nota" OnValidSubmit="DescartarAsync"></EditForm>
    return;
}

<ResumenErrores Mensaje="@error" Errores="@errores" />

<div class="mb-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <form method="get" action="/notas-credito-venta" data-enhance class="p-4 sm:p-6">
        <input type="hidden" name="estado" value="preparacion" />
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="grid max-w-4xl flex-1 grid-cols-1 gap-3 sm:grid-cols-3">
                <div>
                    <label class="mb-1 block text-xs font-semibold text-slate-500" for="prepNombre">Cliente</label>
                    <input id="prepNombre" type="text" name="nombre" value="@Nombre" placeholder="ej. Comercial" class="@VentasCss.Filtro" />
                </div>
                <div>
                    <label class="mb-1 block text-xs font-semibold text-slate-500" for="prepFactura">Factura de origen</label>
                    <input id="prepFactura" type="text" name="factura" value="@Factura" placeholder="ej. FV-000123" class="@VentasCss.Filtro" />
                </div>
                <div>
                    <label class="mb-1 block text-xs font-semibold text-slate-500" for="prepNumero">Número interno</label>
                    <input id="prepNumero" type="text" name="numero" value="@Numero" class="@VentasCss.Filtro" />
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Consultar</button>
                <a href="@RutasPreparacion.ListaNotas" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Limpiar campos</a>
            </div>
        </div>
    </form>
</div>

<div class="mb-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-6 py-4">
        <h2 class="text-sm font-semibold text-slate-700">Notas de crédito en preparación</h2>
        <p class="mt-1 text-xs text-slate-500">@total resultado(s) · página @pagina de @Math.Max(totalPaginas, 1).</p>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm" data-testid="tabla-en-preparacion">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-slate-500">Cliente</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-slate-500">Factura de origen</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-slate-500">Creado el</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500">Líneas</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500" title="Suma de las líneas en preparación; al registrar se limita a lo que queda por acreditar de la factura.">Total estimado</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-slate-500">Estado</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 bg-white">
                @if (notas.Count == 0)
                {
                    <tr><td colspan="7" class="px-4 py-8 text-center text-sm text-slate-400">No hay notas de crédito en preparación con esos criterios.</td></tr>
                }
                @foreach (var b in notas)
                {
                    <tr @key="b.Id" class="hover:bg-slate-50">
                        <td class="px-4 py-3 text-slate-700">@b.SocioNegocioCodigo <span class="text-xs text-slate-400">@b.NombreFacturacion</span></td>
                        <td class="px-4 py-3"><a href="@($"/facturas-venta/{Uri.EscapeDataString(b.FacturaVentaNumero)}")" class="font-mono text-xs text-brand-700 hover:underline">@b.FacturaVentaNumero</a></td>
                        <td class="px-4 py-3 text-xs text-slate-500">@EntradaFecha.Formatear(DateOnly.FromDateTime(b.CreatedAtUtc))</td>
                        <td class="px-4 py-3 text-right text-slate-700">@b.NumeroLineas</td>
                        <td class="px-4 py-3 text-right font-semibold text-slate-800">@VentasOpciones.Importe(b.ImporteTotal)</td>
                        <td class="px-4 py-3 text-xs"><span class="@ListaPreparacion.CssEstadoAbierta">@VentasOpciones.EstadoNota(b.Estado)</span></td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a href="@($"{RutasPreparacion.Nota}/{b.Id}")" aria-label="@($"Continuar la nota de crédito de {b.NombreFacturacion}")" class="btn-press rounded-lg border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 hover:bg-brand-100">Continuar</a>
                                @if (Permisos?.CanDelete == true)
                                {
                                    <a href="@Url(deleteId: b.Id)" aria-label="@($"Descartar la nota de crédito de {b.NombreFacturacion}")" class="btn-press rounded-lg border border-red-200 bg-red-50 px-3 py-1 text-xs font-semibold text-red-700 hover:bg-red-100">Descartar</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="border-t border-slate-100 px-6 py-3 text-xs text-slate-500" data-testid="aviso-total-estimado">Total estimado: suma de las líneas en preparación. Al registrar, el importe se limita a lo que queda por acreditar de la factura.</p>
    @if (totalPaginas > 1)
    {
        <div class="flex items-center justify-between gap-3 border-t border-slate-100 px-6 py-4">
            <p class="text-xs text-slate-500">Página @pagina de @totalPaginas</p>
            <div class="flex items-center gap-2">
                @if (pagina > 1)
                {
                    <a href="@Url(pagina: pagina - 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">« Anterior</a>
                }
                @if (pagina < totalPaginas)
                {
                    <a href="@Url(pagina: pagina + 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Siguiente »</a>
                }
            </div>
        </div>
    }
</div>

@if (MuestraDialogo)
{
    <ConfirmDialog Title="Descartar nota de crédito" Message="Se descartará la nota de crédito en preparación con todas sus líneas. No se puede deshacer." Variant="danger" CancelHref="@Url()">
        <p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-900">@(aDescartar is null ? DeleteId?.ToString() : $"{aDescartar.NombreFacturacion} — factura {aDescartar.FacturaVentaNumero} ({aDescartar.NumeroLineas} línea(s))")</p>
        <EditForm Model="DeleteInput" FormName="delete-borrador-nota" OnValidSubmit="DescartarAsync" class="mt-4">
            <input type="hidden" name="DeleteInput.Id" value="@DeleteId" />
            <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">Sí, descartar</button>
            <a href="@Url()" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}
else
{
    <EditForm Model="DeleteInput" FormName="delete-borrador-nota" OnValidSubmit="DescartarAsync"></EditForm>
}

@code {
    [Parameter] public string? Numero { get; set; }
    [Parameter] public string? Factura { get; set; }
    [Parameter] public string? Nombre { get; set; }
    [Parameter] public int Pagina { get; set; } = 1;
    [Parameter] public Guid? DeleteId { get; set; }
    [Parameter] public string? Ok { get; set; }
    [Parameter] public PermisosPagina? Permisos { get; set; }

    /// <summary>Pestaña "Registradas": solo el formulario de descarte (vacío) y su resumen de errores; no carga la lista.</summary>
    [Parameter] public bool SoloFormulario { get; set; }

    [SupplyParameterFromForm(FormName = "delete-borrador-nota")] private DescartarDocumentoForm? DeleteInput { get; set; }

    private IReadOnlyList<NotaCreditoVentaBorradorResponse> notas = [];
    private NotaCreditoVentaBorradorResponse? aDescartar;
    private long total;
    private int totalPaginas;
    private int pagina = 1;
    private string? error;
    private IReadOnlyList<string> errores = [];

    private bool MuestraDialogo => DeleteId.HasValue && Permisos?.CanDelete == true;

    protected override async Task OnInitializedAsync()
    {
        DeleteInput ??= new();
        if (SoloFormulario)
        {
            return;
        }

        try
        {
            // Sin estado = en preparación (Abierta).
            var filtro = new NotaCreditoVentaBorradorFiltro(
                ListaPreparacion.Vacio(Numero), ListaPreparacion.Vacio(Factura), ListaPreparacion.Vacio(Nombre), null);
            var (resultado, paginaCargada) = await ListaPreparacion.CargarAsync(p => NotaApiClient.ListBorradoresAsync(filtro, p), Pagina);
            (notas, total, totalPaginas, pagina) = (resultado.Items, resultado.Total, resultado.TotalPaginas, paginaCargada);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load notas de crédito en preparación.");
            error = "No fue posible cargar las notas de crédito en preparación.";
        }

        if (MuestraDialogo)
        {
            aDescartar = notas.FirstOrDefault(n => n.Id == DeleteId);
            if (aDescartar is null)
            {
                try { aDescartar = await NotaApiClient.GetBorradorAsync(DeleteId!.Value); }
                catch (Exception ex) { Logger.LogWarning(ex, "Could not load nota de crédito en preparación {Id} to discard.", DeleteId); }
            }
        }
    }

    private async Task DescartarAsync()
    {
        var (destino, mensaje, lista) = await ListaPreparacion.DescartarAsync(
            () => NotaApiClient.DeleteBorradorAsync(DeleteInput!.Id), Url(), Logger, "No fue posible descartar la nota de crédito.");
        (error, errores) = (mensaje, lista);

        // R17: la navegación va FUERA del try (dentro de ListaPreparacion.DescartarAsync).
        if (destino is not null)
        {
            Nav.NavigateTo(destino);
        }
    }

    private string Url(int? pagina = null, Guid? deleteId = null) =>
        ListaPreparacion.Url(RutasPreparacion.ListaNotas, [("numero", Numero), ("factura", Factura), ("nombre", Nombre)], pagina ?? this.pagina, deleteId);
}
