@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="es" class="@(IsDarkMode ? "dark" : "")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <!-- Tailwind CSS Play CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js (gráficos de dashboard) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:  '#eef3ff',
                            100: '#dce6ff',
                            200: '#bcd0ff',
                            300: '#8aadff',
                            400: '#567fff',
                            500: '#2f54fc',
                            600: '#2155d9',
                            700: '#1a44c2',
                            800: '#1939a0',
                            900: '#1b337e',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'ui-sans-serif', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'sans-serif'],
                    },
                    keyframes: {
                        'fade-in': {
                            '0%':   { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        'slide-up': {
                            '0%':   { opacity: '0', transform: 'translateY(24px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        },
                        'slide-in-left': {
                            '0%':   { opacity: '0', transform: 'translateX(-24px)' },
                            '100%': { opacity: '1', transform: 'translateX(0)' },
                        },
                        'pop': {
                            '0%':   { opacity: '0', transform: 'scale(0.88)' },
                            '70%':  { transform: 'scale(1.04)' },
                            '100%': { opacity: '1', transform: 'scale(1)' },
                        },
                        'pulse-glow': {
                            '0%, 100%': { boxShadow: '0 0 0 0 rgba(33,85,217,0.4)' },
                            '50%':      { boxShadow: '0 0 0 10px rgba(33,85,217,0)' },
                        },
                        'float': {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%':      { transform: 'translateY(-6px)' },
                        },
                    },
                    animation: {
                        'fade-in':       'fade-in 0.5s ease-out both',
                        'slide-up':      'slide-up 0.5s ease-out both',
                        'slide-up-slow': 'slide-up 0.7s ease-out both',
                        'slide-in-left': 'slide-in-left 0.5s ease-out both',
                        'pop':           'pop 0.4s ease-out both',
                        'pulse-glow':    'pulse-glow 2s ease-in-out infinite',
                        'float':         'float 3s ease-in-out infinite',
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body class="bg-slate-50 font-sans text-slate-800 antialiased dark:bg-slate-900 dark:text-slate-100">
    <div id="nav-progress-bar" class="blazor-loading-bar" style="width:0;opacity:0;" aria-hidden="true"></div>
    <Routes />
    <LoadingOverlay />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["app.interactions.js"]"></script>
    <script src="@Assets["app.search.js"]"></script>
    <script src="@Assets["app.menus.js"]"></script>
    <script src="@Assets["app.errores.js"]"></script>
    <script src="@Assets["app.charts.js"]"></script>
</body>

</html>

@code {
    private bool IsDarkMode => HttpContextAccessor.HttpContext?.Request.Cookies["axionerp-theme"] == "dark";
}
