@page "/facturas-venta"
@page "/facturas-venta/{Numero}"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.FacturasVenta.Calculo
@using OpenSource1.Application.Features.FacturasVenta.Copia
@using OpenSource1.Application.Features.FacturasVenta.Posteadas
@using OpenSource1.Application.Features.FacturasVenta.Posteadas.Dtos
@using OpenSource1.Application.Features.NotasCreditoVenta.Borradores.Dtos
@using OpenSource1.Application.Features.NotasCreditoVenta.Posteadas
@using OpenSource1.Application.Features.NotasCreditoVenta.Posteadas.Dtos
@using OpenSource1.Application.Features.SociosNegocio.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Common
@using OpenSource1.Core.Enums
@inject IFacturaVentaApiClient FacturaApiClient
@inject INotaCreditoVentaApiClient NotaApiClient
@inject ISocioNegocioApiClient SocioApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<FacturasVenta> Logger
@inject NavigationManager Nav

<PageTitle>@(Numero is null ? "Facturas de venta" : $"Factura {Numero}") – AxionERP</PageTitle>

@if (Numero is null)
{
    <PageToolbar Titulo="Facturas" Subtitulo="Facturas de venta registradas y en preparación."
                 Migas="@MigasListado" Permisos="@permisos"
                 NuevoHref="@RetornoLocal.ConRetorno("/facturas-venta/nueva", UrlActual)" NuevoTexto="Nueva factura"
                 SeleccionId="@FacturaSeleccionada?.Numero"
                 Crear="@CrearFactura" Ver="@VerFactura" RetornoUrl="@UrlActual" />
    <PestanasDocumento Base="/facturas-venta" EnPreparacion="@EnPreparacion" Conteo="@conteoEnPreparacion" />
}
else
{
    <PageToolbar Titulo="@($"Factura {Numero}")" Subtitulo="Documento legal registrado: cabecera, líneas y líneas de IVA."
                 Migas="@MigasDetalle" Permisos="@permisos"
                 SeleccionId="@detalle?.Cabecera.Numero"
                 Crear="@CrearDetalle" Ver="@VerDetalle" RetornoUrl="@UrlFactura">
        @* Spec alta rápida: un clic crea la nota de crédito total en preparación; si ya hay una de esta factura, se continúa esa. Con el
           diálogo ?crearNota=true a la vista no se pinta (un solo formulario "crear-nota" a la vez). *@
        @if (MuestraContinuarNota)
        {
            <a href="@($"{RutasPreparacion.Nota}/{NotaEnPreparacion!.Id}")" data-testid="continuar-nota" class="btn-press rounded-lg bg-brand-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Continuar nota de crédito</a>
        }
        else if (MuestraBotonCrearNota)
        {
            <EditForm Model="CrearNotaInput" FormName="crear-nota" OnValidSubmit="CrearNotaAsync">
                <button type="submit" data-testid="crear-nota" class="btn-press rounded-lg bg-brand-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Crear nota de crédito</button>
            </EditForm>
        }
        <a href="/facturas-venta" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">Volver al listado</a>
    </PageToolbar>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6">
        @if (messageType == "success")
        {
            <ActionFeedback Type="success" Title="Factura registrada" Message="@message" />
            @if (Numero is not null && Ok is "posteada" or "registrada")
            {
                <a href="/facturas-venta/nueva" data-testid="nueva-factura" class="btn-press mt-2 inline-block rounded-lg border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 hover:bg-brand-100">Nueva factura</a>
            }
        }
        else
        {
            <MessageBox Type="@messageType" Message="@message" Errors="@errores" />
        }
    </div>
}

@if (detalle is not null && Ok is "posteada" or "registrada" && CalculoNumeroSerie.EsTextoAviso(AvisoNumeracion))
{
    <div class="mb-6" data-testid="aviso-numeracion"><MessageBox Type="warning" Message="@AvisoNumeracion" /></div>
}

@if (copia is not null)
{
    <div class="mb-6">
        <MessageBox Type="warning" Message="Se creó la factura en preparación, pero algunas líneas no se copiaron:" Errors="@copia.Avisos" />
        <a data-testid="borrador-copiado" href="@($"{RutasPreparacion.Factura}/{copia.BorradorId}")" class="mt-2 inline-block text-sm font-semibold text-brand-600 hover:underline">Abrir la factura en preparación</a>
    </div>
}

@if (EnPreparacion)
{
    <ListaFacturasEnPreparacion Numero="@SearchNumero" Nombre="@SearchNombre" Pagina="@Pagina" DeleteId="@DeleteId" Ok="@Ok" Permisos="@permisos" />
}
else if (Numero is null)
{
    @* PF6: el descarte de la pestaña "En preparación" también está en el árbol aquí (formulario vacío). *@
    <ListaFacturasEnPreparacion SoloFormulario="true" Ok="@Ok" />

    <!-- ── Filtros ── -->
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
        <form method="get" action="/facturas-venta" data-enhance class="p-4 sm:p-6">
            @if (SocioId is not null)
            {
                <input type="hidden" name="socioId" value="@SocioId" />
            }
            <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div class="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-4 max-w-5xl">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroNumero">Número</label>
                        <input id="filtroNumero" type="text" name="numero" value="@SearchNumero" placeholder="ej. 00000001" class="@FiltroCss" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroNombre">Nombre de facturación</label>
                        <input id="filtroNombre" type="text" name="nombre" value="@SearchNombre" class="@FiltroCss" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroDesde">Desde (fecha registro)</label>
                        <input id="filtroDesde" type="date" name="desde" value="@SearchDesde" class="@FiltroCss" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroHasta">Hasta</label>
                        <input id="filtroHasta" type="date" name="hasta" value="@SearchHasta" class="@FiltroCss" />
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Consultar</button>
                    <a href="@(SocioId is null ? "/facturas-venta" : $"/facturas-venta?socioId={SocioId}")" title="Limpiar campos" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Limpiar campos</a>
                </div>
            </div>
            @if (SocioId is not null)
            {
                <p class="mt-4 inline-flex flex-wrap items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700" data-testid="filtro-cliente">
                    Cliente: @(socioFiltro is null ? SocioId.ToString() : $"{socioFiltro.Codigo} — {socioFiltro.NombreComercial}")
                    <a href="@BuildListUrl(1, conSocio: false, conSel: false)" class="underline hover:text-brand-900">Quitar</a>
                </p>
            }
        </form>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-slate-100">
            <h2 class="text-sm font-semibold text-slate-700">Facturas registradas</h2>
            <p class="mt-1 text-xs text-slate-500">@total resultado(s) · página @Pagina de @Math.Max(totalPaginas, 1).</p>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-100 text-sm" data-testid="tabla-facturas">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3"><span class="sr-only">Seleccionar</span></th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Número</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Facturar a</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Fecha reg.</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Vence</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Sin IVA</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">IVA</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Total</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Asiento</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 bg-white">
                    @if (facturas.Count == 0)
                    {
                        <tr><td colspan="9" class="px-4 py-8 text-center text-slate-400 text-sm">No hay facturas con esos criterios.</td></tr>
                    }
                    @foreach (var f in facturas)
                    {
                        var marcada = f.Numero == FacturaSeleccionada?.Numero;
                        <tr @key="f.Numero" class="@SeleccionFila.ClaseFila @(marcada ? SeleccionFila.ClaseFilaSeleccionada : null)">
                            <td class="px-4 py-3"><SeleccionFila Href="@BuildListUrl(Pagina, sel: f.Numero)" Seleccionada="@marcada" Etiqueta="@f.Numero" /></td>
                            <td class="px-4 py-3"><a href="@($"/facturas-venta/{Uri.EscapeDataString(f.Numero)}")" class="font-mono text-xs font-semibold text-brand-700 hover:underline">@f.Numero</a></td>
                            <td class="px-4 py-3 text-slate-700">@f.SocioNegocioFacturarACodigo <span class="text-xs text-slate-400">@f.NombreFacturacion</span></td>
                            <td class="px-4 py-3 text-xs text-slate-500">@EntradaFecha.Formatear(f.FechaRegistro)</td>
                            <td class="px-4 py-3 text-xs text-slate-500">@EntradaFecha.Formatear(f.FechaVencimiento)</td>
                            <td class="px-4 py-3 text-right text-slate-700">@VentasOpciones.Importe(f.ImporteSinIva)</td>
                            <td class="px-4 py-3 text-right text-slate-700">@VentasOpciones.Importe(f.ImporteIva)</td>
                            <td class="px-4 py-3 text-right font-semibold text-slate-900">@VentasOpciones.Importe(f.ImporteTotal)</td>
                            <td class="px-4 py-3 font-mono text-xs text-slate-500">@(f.NumeroRegistroContable ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPaginas > 1)
        {
            <div class="flex items-center justify-between gap-3 border-t border-slate-100 px-6 py-4">
                <p class="text-xs text-slate-500">Página @Pagina de @totalPaginas</p>
                <div class="flex items-center gap-2">
                    @if (Pagina > 1)
                    {
                        <a href="@BuildListUrl(Pagina - 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">« Anterior</a>
                    }
                    @if (Pagina < totalPaginas)
                    {
                        <a href="@BuildListUrl(Pagina + 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Siguiente »</a>
                    }
                </div>
            </div>
        }
    </div>
}
else if (detalle is null)
{
    @if (!detalleCargaFallida)
    {
        <div class="rounded-2xl border border-slate-200 bg-white px-8 py-12 text-center text-slate-400 shadow-sm"><p class="font-semibold text-slate-500">No se encontró la factura @Numero.</p></div>
    }
}
else
{
    var c = detalle.Cabecera;
    @* NS20: diseño del documento en solo lectura; "cabecera-factura" y la etiqueta "Vender a" los usa el E2E 06. *@
    <div data-testid="cabecera-factura">
        <DocumentoCabecera Campos="@CamposFactura(c)" />
    </div>

    <DocumentoLineasLectura TLinea="LineaFacturaVentaResponse" Columnas="ColumnasFactura" Lineas="@detalle.Lineas.OrderBy(l => l.NumeroLinea).ToList()"
                            TextoVacio="La factura no tiene líneas." />

    <DocumentoTotales Totales="@TotalesDocumento.Desde(detalle)" MostrarCuenta="true" />
    <p class="-mt-3 mb-8 text-xs"><a class="text-brand-700 underline" href="@($"/cobros?socioId={c.SocioNegocioFacturarAId}")">Movimientos y cobros del cliente</a></p>

    <!-- ── Notas de crédito de la factura ── -->
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8" data-testid="notas-factura">
        <div class="px-6 py-4 border-b border-slate-100 flex flex-wrap items-center justify-between gap-2">
            <div>
                <h2 class="text-sm font-semibold text-slate-700">Notas de crédito</h2>
                <p class="mt-1 text-xs text-slate-500">@(notasCargaFallida ? "No fue posible cargar las notas de crédito de la factura." : $"{notasFactura.Count} registrada(s) por {VentasOpciones.Importe(notasFactura.Sum(n => n.ImporteTotal))} · {borradoresNota.Count} en preparación.")</p>
            </div>
            @* La nota se crea desde la barra ("Crear nota de crédito" o Crear ▾, solo con importe pendiente); aquí solo se informa si ya no queda nada. *@
            @if (!notasCargaFallida && !TienePendiente)
            {
                <span class="text-xs font-semibold text-slate-500">Factura acreditada por completo.</span>
            }
        </div>
        @if (notasFactura.Count > 0 || borradoresNota.Count > 0)
        {
            <table class="min-w-full divide-y divide-slate-100 text-sm">
                <thead class="bg-slate-50"><tr>
                    <th class="px-4 py-2 text-left text-xs font-semibold text-slate-500 uppercase">Número</th>
                    <th class="px-4 py-2 text-left text-xs font-semibold text-slate-500 uppercase">Estado</th>
                    <th class="px-4 py-2 text-left text-xs font-semibold text-slate-500 uppercase">Fecha reg.</th>
                    <th class="px-4 py-2 text-right text-xs font-semibold text-slate-500 uppercase">Total</th>
                    <th class="px-4 py-2 text-left text-xs font-semibold text-slate-500 uppercase">Asiento</th>
                </tr></thead>
                <tbody class="divide-y divide-slate-50">
                    @foreach (var n in notasFactura)
                    {
                        <tr @key="n.Numero">
                            <td class="px-4 py-2"><a class="font-mono text-xs font-semibold text-brand-700 underline" href="@($"/notas-credito-venta/{Uri.EscapeDataString(n.Numero)}")">@n.Numero</a></td>
                            <td class="px-4 py-2 text-xs text-slate-700">Registrada</td>
                            <td class="px-4 py-2 text-xs text-slate-500">@EntradaFecha.Formatear(n.FechaRegistro)</td>
                            <td class="px-4 py-2 text-right font-semibold text-slate-800">@VentasOpciones.Importe(n.ImporteTotal)</td>
                            <td class="px-4 py-2 font-mono text-xs text-slate-500">@(n.NumeroRegistroContable ?? "—")</td>
                        </tr>
                    }
                    @foreach (var b in borradoresNota)
                    {
                        <tr @key="b.Id">
                            @* Spec §1.2: sin el número interno de preparación; "En preparación" y "Continuar". *@
                            <td class="px-4 py-2"><span class="text-xs font-semibold text-amber-700" data-testid="nota-fila-preparacion">En preparación</span></td>
                            <td class="px-4 py-2 text-xs text-slate-700"><a class="font-semibold text-brand-700 underline" href="@($"{RutasPreparacion.Nota}/{b.Id}")" data-testid="continuar-nota-fila">Continuar</a> <span class="text-slate-500">(@b.NumeroLineas línea(s))</span></td>
                            <td class="px-4 py-2 text-xs text-slate-500">@EntradaFecha.Formatear(b.FechaRegistro)</td>
                            <td class="px-4 py-2 text-right text-slate-400">—</td>
                            <td class="px-4 py-2 text-xs text-slate-400">—</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (MuestraFormCrearNota)
    {
        <ConfirmDialog Title="Crear nota de crédito" Message="@($"Se creará una nota de crédito en preparación de la factura {c.Numero} con todas sus líneas pendientes y la devolución al inventario; podrá ajustar las cantidades o quitar líneas antes de registrarla.")" Variant="warning" CancelHref="@VolverNota">
            @if (crearNotaError is not null)
            {
                <div class="mb-4" data-testid="errores-crear-nota"><ResumenErrores Mensaje="@crearNotaError" Errores="@crearNotaErrores" /></div>
            }
            <EditForm Model="CrearNotaInput" FormName="crear-nota" OnValidSubmit="CrearNotaAsync" Enhance="true">
                <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Sí, crear</button>
                <a href="@VolverNota" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
            </EditForm>
        </ConfirmDialog>
    }

    @if (MuestraDialogoCopiar)
    {
        <ConfirmDialog Title="Copiar a factura en preparación" Message="@($"Se creará una factura en preparación con la cabecera y las líneas de la factura {c.Numero}, la fecha de hoy y los datos actuales del cliente.")" Variant="success" CancelHref="@UrlFactura">
            <EditForm Model="CopiarInput" FormName="copiar-borrador" OnValidSubmit="CopiarAsync" class="mt-4">
                <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Sí, copiar</button>
                <a href="@UrlFactura" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
            </EditForm>
        </ConfirmDialog>
    }
}

@* Copiar a borrador: el formulario queda en el árbol aunque el diálogo no se muestre (sin CanAdd, sin ?copiar=true o copia ya
   hecha): un POST forzado u obsoleto llega al handler y recibe el mensaje real de la API. *@
@if (!MuestraDialogoCopiar)
{
    <EditForm Model="CopiarInput" FormName="copiar-borrador" OnValidSubmit="CopiarAsync"></EditForm>
}

@* El formulario de alta de la nota se mantiene en el árbol aunque el permiso o el estado (factura acreditada del todo, nota ya en
   preparación, diálogo cerrado) no muestren ni el diálogo ni el botón de la barra: un POST obsoleto o forzado llega al handler y
   recibe el mensaje real de la API (403/400). *@
@if (!MuestraFormCrearNota && !MuestraBotonCrearNota)
{
    <EditForm Model="CrearNotaInput" FormName="crear-nota" OnValidSubmit="CrearNotaAsync"></EditForm>
}

@code {
    private const string FiltroCss = "block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20";

    [Parameter] public string? Numero { get; set; }

    [SupplyParameterFromQuery(Name = "numero")] private string? SearchNumero { get; set; }
    [SupplyParameterFromQuery(Name = "nombre")] private string? SearchNombre { get; set; }
    [SupplyParameterFromQuery(Name = "desde")] private string? SearchDesde { get; set; }
    [SupplyParameterFromQuery(Name = "hasta")] private string? SearchHasta { get; set; }
    [SupplyParameterFromQuery(Name = "pagina")] private int Pagina { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "crearNota")] private bool CrearNota { get; set; }
    [SupplyParameterFromQuery(Name = "copiar")] private bool CopiarConfirm { get; set; }
    // Aviso de numeración del posteo (NS4): lo añade el borrador al redirigir aquí tras postear.
    [SupplyParameterFromQuery(Name = "aviso")] private string? AvisoNumeracion { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] private string? ReturnUrl { get; set; }
    // Tolerante (ola final Fix-Features): un ?socioId= ilegible se ignora; con Guid? el binder lanzaría (página de error).
    [SupplyParameterFromQuery(Name = "socioId")] private string? SocioIdTexto { get; set; }
    private Guid? SocioId => InventarioVistasOpciones.ParseGuid(SocioIdTexto);
    [SupplyParameterFromQuery(Name = "sel")] private string? Sel { get; set; }
    // Spec alta rápida: ?estado=preparacion es la pestaña "En preparación"; deleteId abre allí la confirmación de "Descartar".
    [SupplyParameterFromQuery(Name = "estado")] private string? Estado { get; set; }
    [SupplyParameterFromQuery(Name = "deleteId")] private Guid? DeleteId { get; set; }

    private bool EnPreparacion => Numero is null && string.Equals(Estado, "preparacion", StringComparison.OrdinalIgnoreCase);

    [SupplyParameterFromForm(FormName = "crear-nota")] private CrearNotaForm? CrearNotaInput { get; set; }
    [SupplyParameterFromForm(FormName = "copiar-borrador")] private AccionCopiarForm? CopiarInput { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<FacturaVentaResponse> facturas = [];
    private long total;
    private int totalPaginas;
    private FacturaVentaDetalleResponse? detalle;
    private bool detalleCargaFallida;
    private string? message;
    private string messageType = "info";
    private IReadOnlyList<string> errores = [];
    private bool canAdd;
    private PermisosPagina? permisos;
    private SocioNegocioResponse? socioFiltro;
    private IReadOnlyList<NotaCreditoVentaResponse> notasFactura = [];
    private IReadOnlyList<NotaCreditoVentaBorradorResponse> borradoresNota = [];
    private Dictionary<long, (decimal Cantidad, decimal Importe, decimal Devuelto)> acreditadoPorLinea = [];
    private bool notasCargaFallida;
    private string? crearNotaError;
    private IReadOnlyList<string> crearNotaErrores = [];
    private CopiaFacturaResponse? copia;
    private long? conteoEnPreparacion;

    private static readonly IReadOnlyList<Miga> MigasListado = [new("Facturación", "/modulos/facturacion"), new("Facturas")];

    private IReadOnlyList<Miga> MigasDetalle => [new("Facturación", "/modulos/facturacion"), new("Facturas", "/facturas-venta"), new(Numero!)];

    /// <summary>Selección válida: solo una factura de la página cargada (una selección obsoleta deja las acciones deshabilitadas).</summary>
