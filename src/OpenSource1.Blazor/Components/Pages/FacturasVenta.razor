    /// <summary>Nota de crédito en preparación de esta factura (la lista ya carga solo las de la factura): "Continuar" en vez de crear otra.</summary>
    private NotaCreditoVentaBorradorResponse? NotaEnPreparacion => borradoresNota.FirstOrDefault();

    /// <summary>Diálogo ?crearNota=true (lo abre Crear ▾): sin campos; no se muestra si ya hay una nota en preparación (se continúa esa).</summary>
    private bool MuestraFormCrearNota => detalle is not null && canAdd && CrearNota && NotaEnPreparacion is null;

    /// <summary>"Continuar nota de crédito" en la barra: con importe pendiente y una nota de esta factura ya en preparación.</summary>
    private bool MuestraContinuarNota => canAdd && detalle is not null && TienePendiente && NotaEnPreparacion is not null;

    /// <summary>"Crear nota de crédito" en la barra: con importe pendiente, sin nota en preparación y sin el diálogo a la vista (PF1).</summary>
    private bool MuestraBotonCrearNota => canAdd && detalle is not null && TienePendiente && NotaEnPreparacion is null && !CrearNota;

    /// <summary>Diálogo de Copiar a borrador: con ?copiar=true y CanAdd, mientras no se haya hecho ya la copia (con avisos).</summary>
    private bool MuestraDialogoCopiar => detalle is not null && canAdd && CopiarConfirm && copia is null;

    /// <summary>Queda algo por acreditar en alguna línea (si las notas no cargaron, se asume que sí: la API valida).</summary>
    private bool TienePendiente => detalle is not null && (notasCargaFallida || detalle.Lineas
        .Where(l => l.Tipo != TipoLineaFactura.Comentario)
        .Any(l => l.Cantidad > Acreditado(l.Id).Cantidad));

    private (decimal Cantidad, decimal Importe, decimal Devuelto) Acreditado(long lineaId) =>
        acreditadoPorLinea.TryGetValue(lineaId, out var a) ? a : (0m, 0m, 0m);

    protected override async Task OnInitializedAsync()
    {
        CrearNotaInput ??= new();
        CopiarInput ??= new();
        permisos = await PermisosPagina.CargarAsync(AuthorizationService, AuthenticationStateTask);
        canAdd = permisos.CanAdd;
    }

    protected override async Task OnParametersSetAsync()
    {
        message = null;
        if (Numero is null)
        {
            try
            {
                conteoEnPreparacion = await FacturaApiClient.ContarEnPreparacionAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not count facturas en preparación.");
                conteoEnPreparacion = null;
            }

            if (!EnPreparacion)
            {
                await CargarListadoAsync();
            }

            return;
        }

        try
        {
            detalle = await FacturaApiClient.GetFacturaAsync(Numero);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load factura {Numero}.", Numero);
            detalleCargaFallida = true;
            Show("danger", "No fue posible cargar la factura.");
            return;
        }

        if (detalle is not null)
        {
            await CargarNotasAsync(detalle.Cabecera.Numero);
        }

        if (Ok is "posteada" or "registrada" && detalle is not null)
        {
            // "posteada": enlaces de la versión anterior. El texto del spec ("Factura FV-000123 registrada.") y, detrás, el importe y el asiento.
            var registro = detalle.Cabecera.NumeroRegistroContable;
            Show("success", $"Factura {detalle.Cabecera.Numero} registrada. Total {VentasOpciones.Importe(detalle.Cabecera.ImporteTotal)}. " +
                (registro is null ? "Total 0 (100 % de descuento): sin movimiento de cliente ni registro contable." : $"Registro contable {registro}."));
        }
    }

    /// <summary>
    /// Notas posteadas de la factura (con lo acreditado y lo devuelto por línea, sumando las líneas de sus detalles: la API de notas
    /// no expone un agregado por factura) y borradores de nota pendientes. El filtro de la API es "contiene": se queda solo lo exacto.
    /// </summary>
    private async Task CargarNotasAsync(string numeroFactura)
    {
        try
        {
            var paginaNotas = await NotaApiClient.ListNotasAsync(
                new NotaCreditoVentaSearchCriteria(FacturaVentaNumero: numeroFactura), new PageRequest(1, PageRequest.TamanoMaximo, "Numero", Descendente: false));
            notasFactura = paginaNotas.Items.Where(n => n.FacturaVentaNumero == numeroFactura).ToList();
            var acumulado = new Dictionary<long, (decimal Cantidad, decimal Importe, decimal Devuelto)>();
            foreach (var nota in notasFactura)
            {
                var detalleNota = await NotaApiClient.GetNotaAsync(nota.Numero)
                    ?? throw new InvalidOperationException($"La nota {nota.Numero} no se encontró al leer su detalle.");
                foreach (var linea in detalleNota.Lineas)
                {
                    var previo = acumulado.GetValueOrDefault(linea.LineaFacturaVentaId);
                    acumulado[linea.LineaFacturaVentaId] = (
                        previo.Cantidad + linea.Cantidad, previo.Importe + linea.ImporteLinea, previo.Devuelto + (linea.DevolverInventario ? linea.Cantidad : 0m));
                }
            }

            acreditadoPorLinea = acumulado;
            var paginaBorradores = await NotaApiClient.ListBorradoresAsync(
                new NotaCreditoVentaBorradorFiltro(null, numeroFactura, null, null), new PageRequest(1, PageRequest.TamanoMaximo, "CreatedAtUtc", Descendente: false));
            borradoresNota = paginaBorradores.Items.Where(b => b.FacturaVentaNumero == numeroFactura).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load notas de crédito of factura {Numero}.", numeroFactura);
            notasCargaFallida = true;
        }
    }

    private async Task CrearNotaAsync()
    {
        if (detalle is null)
        {
            // Si la factura no cargó (API caída), se conserva el mensaje de carga.
            if (!detalleCargaFallida)
            {
                Show("warning", "No se encontró la factura registrada.");
            }

            return;
        }

        // Pestaña obsoleta, POST forzado o doble clic: si la factura ya tiene una nota en preparación (cargada en
        // OnParametersSetAsync, que en SSR termina antes de despachar el formulario) se continúa esa en vez de crear otra.
        // R17: fuera de cualquier try/catch.
        if (NotaEnPreparacion is { } existente)
        {
            Nav.NavigateTo($"{RutasPreparacion.Nota}/{existente.Id}");
            return;
        }

        // Spec alta rápida: la nota nace total (todas las líneas pendientes) con la devolución activada; fechas por defecto y series
        // configuradas (la página nunca envía series). Se ajusta después en la nota en preparación.
        string? destino = null;
        try
        {
            var result = await NotaApiClient.CreateBorradorAsync(new NotaCreditoBorradorInput(
                detalle.Cabecera.Numero, null, null, null, CopiarLineas: true, DevolverInventario: true));
            if (result.Succeeded)
            {
                destino = $"{RutasPreparacion.Nota}/{result.Valor!.Id}?ok=creado";
            }
            else
            {
                crearNotaErrores = result.Errors ?? [];
                crearNotaError = result.Message;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not create nota de crédito from factura {Numero}.", detalle.Cabecera.Numero);
            crearNotaError = "No fue posible crear la nota de crédito.";
        }

        // R17: la navegación va fuera del try/catch (la NavigationException de SSR no debe tratarse como error).
        if (destino is not null)
        {
            Nav.NavigateTo(destino);
            return;
        }

        // Si el diálogo no está a la vista (POST obsoleto o sin permiso), el mensaje real se muestra arriba.
        if (!MuestraFormCrearNota)
        {
            errores = crearNotaErrores;
            Show("warning", crearNotaError!);
        }
    }

    /// <summary>
    /// Copiar a borrador: sin avisos abre el borrador nuevo; con avisos (líneas omitidas, almacén sustituido…) se queda aquí y los
    /// muestra con el enlace al borrador; un error muestra el mensaje real de la API (también en un POST forzado sin CanAdd).
    /// </summary>
    private async Task CopiarAsync()
    {
        if (Numero is null)
        {
            return;
        }

        string? destino = null;
        try
        {
            var result = await FacturaApiClient.CopiarABorradorAsync(Numero);
            if (result is { Succeeded: true, Valor: { } valor })
            {
                if (valor.Avisos.Count == 0)
                {
                    destino = $"{RutasPreparacion.Factura}/{valor.BorradorId}?ok=copiado";
                }
                else
                {
                    copia = valor;
                }
            }
            else
            {
                errores = result.Errors ?? [];
                Show("warning", result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not copy factura {Numero} to a borrador.", Numero);
            Show("danger", "No fue posible copiar la factura a una factura en preparación.");
        }

        // R17: la navegación va fuera del try/catch.
        if (destino is not null)
        {
            Nav.NavigateTo(destino);
        }
    }

    private async Task CargarListadoAsync()
    {
        await CargarSocioFiltroAsync();
        DateOnly? desde = null, hasta = null;
        if (!string.IsNullOrWhiteSpace(SearchDesde))
        {
            if (EntradaFecha.TryParse(SearchDesde, out var d, out _)) desde = d;
            else { Show("warning", "La fecha «desde» no es válida."); return; }
        }

        if (!string.IsNullOrWhiteSpace(SearchHasta))
        {
            if (EntradaFecha.TryParse(SearchHasta, out var h, out _)) hasta = h;
            else { Show("warning", "La fecha «hasta» no es válida."); return; }
        }

        try
        {
            // ?socioId= (desde la ficha del cliente) filtra por vender-a o facturar-a en la API.
            var filtro = new FacturaVentaSearchCriteria(EmptyAsNull(SearchNumero), EmptyAsNull(SearchNombre), SocioId, desde, hasta);
            if (Pagina < 1) Pagina = 1;
            // Orden explícito: por número descendente (lo último posteado primero).
            var pagina = await FacturaApiClient.ListFacturasAsync(filtro, new PageRequest(Pagina, PageRequest.TamanoPorDefecto, "Numero", Descendente: true));
            if (pagina.TotalPaginas > 0 && Pagina > pagina.TotalPaginas)
            {
                Pagina = pagina.TotalPaginas;
                pagina = await FacturaApiClient.ListFacturasAsync(filtro, new PageRequest(Pagina, PageRequest.TamanoPorDefecto, "Numero", Descendente: true));
            }

            facturas = pagina.Items;
            total = pagina.Total;
            totalPaginas = pagina.TotalPaginas;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load facturas de venta.");
            Show("danger", "No fue posible cargar las facturas de venta.");
        }
    }

    /// <summary>Cliente del filtro ?socioId= para el chip (si no carga, el chip muestra el id; el filtro se aplica igual).</summary>
    private async Task CargarSocioFiltroAsync()
    {
        if (SocioId is not { } socioId || socioFiltro?.Id == socioId)
        {
            return;
        }

        try
        {
            socioFiltro = await SocioApiClient.GetByIdAsync(socioId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load socio {Id} for the facturas filter.", socioId);
        }
    }

    private string BuildListUrl(int pagina, bool conSocio = true, string? sel = null, bool conSel = true)
    {
        var parameters = new List<string>();
        if (EnPreparacion) parameters.Add("estado=preparacion");
        if (conSocio && SocioId is { } socioId) parameters.Add($"socioId={socioId}");
        if (!string.IsNullOrWhiteSpace(SearchNumero)) parameters.Add($"numero={Uri.EscapeDataString(SearchNumero)}");
        if (!string.IsNullOrWhiteSpace(SearchNombre)) parameters.Add($"nombre={Uri.EscapeDataString(SearchNombre)}");
        if (!string.IsNullOrWhiteSpace(SearchDesde)) parameters.Add($"desde={Uri.EscapeDataString(SearchDesde)}");
        if (!string.IsNullOrWhiteSpace(SearchHasta)) parameters.Add($"hasta={Uri.EscapeDataString(SearchHasta)}");
        if (pagina > 1) parameters.Add($"pagina={pagina}");
        var selEfectiva = sel ?? (conSel ? Sel : null);
        if (!string.IsNullOrWhiteSpace(selEfectiva)) parameters.Add($"sel={Uri.EscapeDataString(selEfectiva)}");
        return parameters.Count == 0 ? "/facturas-venta" : $"/facturas-venta?{string.Join("&", parameters)}";
    }

    private void Show(string type, string text) { messageType = type; message = text; }

    private static string? EmptyAsNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

