    /// <summary>Razón social y RNC de facturación y, debajo en la misma línea, la dirección (línea 1, ciudad y país) guardada en la factura.</summary>
    private static string DetalleFacturarA(FacturaVentaResponse c)
    {
        var fiscal = $"{c.RazonSocialFacturacion} {c.NumeroDocumentoFiscal}".Trim();
        var direccion = string.Join(", ", new[] { c.DireccionFacturacionLinea1, c.CiudadFacturacion, c.PaisCodigoFacturacion }
            .Where(p => !string.IsNullOrWhiteSpace(p)).Select(p => p!.Trim()));
        return string.Join(" · ", new[] { fiscal, direccion }.Where(p => p.Length > 0));
    }

