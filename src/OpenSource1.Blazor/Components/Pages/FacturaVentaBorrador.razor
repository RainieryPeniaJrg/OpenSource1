    private async Task CreateLineaAsync()
    {
        if (borrador is null)
        {
            Show(loadError is null ? "warning" : "danger", BorradorNoCargado);
            return;
        }

        if (EsPosteada)
        {
            // POST obsoleto sobre un borrador ya posteado (Review Focus 5): va a la API, que responde con su conflicto real (409).
            var obsoleto = AddInput!.ToInput((TipoLineaFactura)AddInput.Tipo, AddProductoId, null);
            await EjecutarAsync(() => FacturaApiClient.CreateLineaAsync(BorradorId, obsoleto), "linea_creada", "No fue posible agregar la línea.");
            return;
        }

        if (!Abierta)
        {
            Show("warning", "El borrador está liberado: reábralo para agregar líneas.");
            return;
        }

        if (OpcionesFallidas(AddTipo))
        {
            Show("danger", "No fue posible cargar las opciones de la línea; recargue la página.");
            return;
        }

        if (AddTipo == TipoLineaFactura.Producto && addProducto is null)
        {
            Show("warning", "Seleccione primero un producto.");
            return;
        }

        var input = AddInput!.ToInput(AddTipo, addProducto?.Id, addProducto?.UnidadMedidaBaseId);
        await EjecutarAsync(() => FacturaApiClient.CreateLineaAsync(BorradorId, input), "linea_creada", "No fue posible agregar la línea.", tipo: (int)AddTipo);
    }

    private async Task UpdateLineaAsync()
    {
        if (borrador is null)
        {
            Show(loadError is null ? "warning" : "danger", BorradorNoCargado);
            return;
        }

        if (EsPosteada && EditLineaId is { } lineaObsoleta)
        {
            // POST obsoleto sobre un borrador ya posteado (Review Focus 5): va a la API, que responde con su conflicto real (409).
            var obsoleto = UpdateInputLinea!.ToInput((TipoLineaFactura)UpdateInputLinea.Tipo, lineaAEditar?.ProductoId, lineaAEditar?.UnidadMedidaId);
            await EjecutarAsync(() => FacturaApiClient.UpdateLineaAsync(lineaObsoleta, obsoleto, UpdateInputLinea.Xmin), "linea_modificada", "No fue posible modificar la línea.");
            return;
        }

        if (!Abierta)
        {
            Show("warning", EsPosteada ? "El borrador ya se posteó: es de solo lectura." : "El borrador está liberado: reábralo para modificar líneas.");
            return;
        }

        if (!EditLineaId.HasValue)
        {
            Show("warning", "Seleccione primero una línea a modificar.");
            return;
        }

        if (lineaAEditar is null)
        {
            Show("warning", "No se encontró la línea seleccionada. Puede haber sido eliminada por otro usuario.");
            return;
        }

        if (OpcionesFallidas(lineaAEditar.Tipo))
        {
            Show("danger", "No fue posible cargar las opciones de la línea; recargue la página.");
            return;
        }

        if (lineaAEditar.Tipo == TipoLineaFactura.Producto && (editProducto is null || editProducto.Id == Guid.Empty))
        {
            Show("warning", "Seleccione primero un producto.");
            return;
        }

        var input = UpdateInputLinea!.ToInput(lineaAEditar.Tipo, editProducto?.Id, editProducto?.UnidadMedidaBaseId);
        await EjecutarAsync(() => FacturaApiClient.UpdateLineaAsync(EditLineaId.Value, input, UpdateInputLinea.Xmin), "linea_modificada", "No fue posible modificar la línea.");
    }

    private async Task DeleteLineaAsync() =>
        await EjecutarAsync(() => FacturaApiClient.DeleteLineaAsync(DeleteInputLinea!.Id), "linea_eliminada", "No fue posible eliminar la línea.");

    private async Task LiberarAsync() =>
        await EjecutarAsync(() => FacturaApiClient.LiberarAsync(BorradorId), "liberado", "No fue posible liberar el borrador.");

    private async Task ReabrirAsync() =>
        await EjecutarAsync(() => FacturaApiClient.ReabrirAsync(BorradorId), "reabierto", "No fue posible reabrir el borrador.");

    private async Task GuardarCabeceraAsync()
    {
        if (borrador is null)
        {
            Show(loadError is null ? "warning" : "danger", BorradorNoCargado);
            return;
        }

        if (MuestraFormCabecera && OpcionesCabeceraFallidas)
        {
            Show("danger", "No fue posible cargar los clientes o los almacenes; recargue la página.");
            return;
        }

        // Sin permiso o con el borrador ya posteado/liberado el formulario está vacío en el árbol: el POST (forzado u obsoleto) va a
        // la API igualmente y la página muestra su mensaje real (403/409/400; Review Focus 5).
        var f = UpdateInput!;
        // El vencimiento solo viaja si el usuario lo cambió: "null = conservar" deja que la API lo recalcule con la fecha de documento.
        var vencimiento = f.FechaVencimiento == borrador.FechaVencimiento ? null : f.FechaVencimiento;
        var input = new BorradorCabeceraInput(
            f.SocioNegocioId ?? Guid.Empty, f.SocioNegocioFacturarAId, f.FechaRegistro, f.FechaDocumento, vencimiento, f.AlmacenId,
            f.Descripcion?.Trim() ?? string.Empty, SerieRegistroId: f.SerieRegistroId);
        await EjecutarAsync(() => FacturaApiClient.UpdateBorradorAsync(BorradorId, input, f.Xmin), "modificado", "No fue posible guardar la cabecera.");
    }

    private async Task EliminarBorradorAsync()
    {
        // R17: la navegación va FUERA del try (NavigateTo puede lanzar NavigationException y el catch se la tragaría).
        string? destino = null;
        try
        {
            var result = await FacturaApiClient.DeleteBorradorAsync(BorradorId);
            if (result.Succeeded)
            {
                destino = RetornoLocal.ConParametro(Volver, "ok", "eliminado");
            }
            else
            {
                Show("warning", result.Message, result.Errors);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not delete borrador {Id}.", BorradorId);
            Show("danger", "No fue posible eliminar el borrador.");
        }

        if (destino is not null)
        {
            Nav.NavigateTo(destino);
        }
    }

    private async Task PostearAsync()
    {
        // R17: la navegación va FUERA del try.
        string? destino = null;
        try
        {
            var result = await FacturaApiClient.PostearAsync(BorradorId);
            if (result.Succeeded)
            {
                var r = result.Valor!;
                // El registro contable lo lee la factura del documento. El aviso de numeración (número de aviso alcanzado) lo muestra la
                // factura solo si conserva la forma que genera el posteo (CalculoNumeroSerie.EsTextoAviso).
                var aviso = r.AvisoNumeracion is { } textoAviso ? $"&aviso={Uri.EscapeDataString(textoAviso)}" : string.Empty;
                destino = $"/facturas-venta/{Uri.EscapeDataString(r.Numero)}?ok=posteada{aviso}";
            }
            else
            {
                posteoErrores = result.Errors ?? [];
                posteoError = result.Message;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not postear borrador {Id}.", BorradorId);
            posteoError = "No fue posible postear la factura.";
        }

        if (destino is not null)
        {
            Nav.NavigateTo(destino);
        }
    }

    private async Task EjecutarAsync<T>(Func<Task<VentaOperationResult<T>>> operacion, string ok, string mensajeFallo, int? tipo = null)
    {
        // R17: el destino se calcula dentro del try y la navegación va DESPUÉS del try/catch.
        string? destino = null;
        try
        {
            var result = await operacion();
            if (result.Succeeded)
            {
                destino = RetornoLocal.ConParametro(BuildUrl(tipo: tipo is { } t && t != 1 ? t : null), "ok", ok);
            }
            else
            {
                Show("warning", result.Message, result.Errors);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Borrador {Id}: {Mensaje}", BorradorId, mensajeFallo);
            Show("danger", mensajeFallo);
        }

        if (destino is not null)
        {
            Nav.NavigateTo(destino);
        }
    }

    private string BuildUrl(
        int? tipo = null, Guid? addProductoId = null, string? addProductoQuery = null, Guid? editLineaId = null,
        Guid? editProductoId = null, bool? editBuscar = null, Guid? deleteLineaId = null, bool? postear = null, bool? eliminar = null)
    {
        var parameters = new List<string>();
        if (tipo is { } t) parameters.Add($"tipo={t}");
        if (addProductoId.HasValue) parameters.Add($"addProductoId={addProductoId.Value}");
        if (!string.IsNullOrWhiteSpace(addProductoQuery)) parameters.Add($"addProductoQuery={Uri.EscapeDataString(addProductoQuery)}");
        if (editLineaId.HasValue) parameters.Add($"editLineaId={editLineaId.Value}");
        if (editProductoId.HasValue) parameters.Add($"editProductoId={editProductoId.Value}");
        if (editBuscar == true) parameters.Add("editBuscar=true");
        if (deleteLineaId.HasValue) parameters.Add($"deleteLineaId={deleteLineaId.Value}");
        if (postear == true) parameters.Add("postear=true");
        if (eliminar == true) parameters.Add("eliminar=true");
        // La vuelta (returnUrl, validada: solo rutas locales) acompaña a todas las URL de la página.
        if (!string.IsNullOrWhiteSpace(ReturnUrl)) parameters.Add($"returnUrl={Uri.EscapeDataString(Volver)}");
        return parameters.Count == 0 ? UrlBase : $"{UrlBase}?{string.Join("&", parameters)}";
    }

    /// <summary>returnUrl oculto en los formularios GET de la página (buscadores), para no perder la vuelta.</summary>
    private RenderFragment RetornoOculto => __builder =>
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            <input type="hidden" name="returnUrl" value="@Volver" />
        }
    };

