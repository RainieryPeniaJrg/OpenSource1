                    <p class="text-sm text-slate-700">Producto: <span class="font-semibold">@editProducto.Codigo@(string.IsNullOrWhiteSpace(editProducto.Nombre) ? "" : $" — {editProducto.Nombre}")</span>
                        <span class="text-slate-400 text-xs">· Unidad base: @editProducto.UnidadMedidaCodigo</span></p>
                    <a href="@BuildUrl(editLineaId: EditLineaId, editBuscar: true)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-50">Cambiar producto</a>
                </div>
            }
            <EditForm Model="UpdateInputLinea" FormName="update-linea" OnValidSubmit="UpdateLineaAsync" Enhance="true">
                <DataAnnotationsValidator />
                <input type="hidden" name="UpdateInputLinea.Xmin" value="@UpdateInputLinea!.Xmin" />
                @CamposLinea(UpdateInputLinea, "UpdateInputLinea", lineaAEditar.Tipo, lineaAEditar)
                <div class="mt-5 flex items-center gap-3">
                    @if (!OpcionesFallidas(lineaAEditar.Tipo))
                    {
                        <button type="submit" class="btn-press rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600 shadow-sm">Guardar cambios</button>
