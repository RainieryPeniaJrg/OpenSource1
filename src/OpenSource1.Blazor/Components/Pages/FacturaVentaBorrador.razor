@page "/facturas-venta/en-preparacion/{BorradorId:guid}"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.Almacenes.Dtos
@using OpenSource1.Application.Features.CuentasContables.Dtos
@using OpenSource1.Application.Features.FacturasVenta.Borradores.Dtos
@using OpenSource1.Application.Features.FacturasVenta.Calculo
@using OpenSource1.Application.Features.Productos.Dtos
@using OpenSource1.Application.Features.Series.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Common
@using OpenSource1.Core.Enums
@inject IFacturaVentaApiClient FacturaApiClient
@inject IProductoApiClient ProductoApiClient
@inject IAlmacenApiClient AlmacenApiClient
@inject ICuentaContableApiClient CuentaApiClient
@inject IGrupoContableApiClient GrupoApiClient
@inject ISerieApiClient SerieApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<FacturaVentaBorrador> Logger
@inject NavigationManager Nav

@* Factura en preparación (spec alta rápida; internamente, el borrador): datos derivados en solo lectura, fechas y descripción
   editables, líneas con alta y edición en la fila, totales al pie y 'Registrar factura' (guarda la cabecera y abre la confirmación) /
   'Guardar para después' / 'Descartar factura'. Sin Liberar ni Reabrir (un documento heredado Liberada ofrece 'Volver a editar').
   Registrada: todo en solo lectura con enlace a la factura. Formularios siempre en el árbol: un POST obsoleto o forzado llega al
   handler y muestra el mensaje real de la API. *@

<PageTitle>@Titulo – AxionERP</PageTitle>

<PageToolbar Titulo="@Titulo"
             Subtitulo="@(borrador is null ? null : $"{borrador.NombreFacturacion} · {VentasOpciones.Estado(borrador.Estado)}")"
             Migas="@Migas" Permisos="@permisos" NuevoHref="@null" SeleccionId="@borrador?.Id.ToString()" Ver="@VerDocumento">
    @if (PuedeEliminar)
    {
        <a href="@BuildUrl(eliminar: true)" data-testid="descartar" class="btn-press rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-semibold text-red-700 hover:bg-red-100">Descartar factura</a>
    }
    @if (EsPosteada)
    {
        <a href="@FacturaHref" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">Ver factura @borrador!.FacturaVentaNumero</a>
    }
    <a href="@Volver" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">Volver</a>
</PageToolbar>

@* Un solo resumen de errores a la vez (app.errores.js enfoca el primero): el del registro (en la página o dentro de la confirmación)
   incluye cualquier otro aviso de la petición; si no, el de la última acción. *@
@if (!string.IsNullOrWhiteSpace(message) && messageType == "success")
{
    <div class="mb-6"><ActionFeedback Type="success" Message="@message" /></div>
}
@if (posteoError is not null)
{
    @if (!MuestraDialogoPosteo)
    {
        <div data-testid="errores-posteo"><ResumenErrores Mensaje="@posteoError" Errores="@ErroresPosteo" /></div>
    }
}
else if (messageType != "success")
{
    <ResumenErrores Mensaje="@message" Errores="@errores" />
}

@if (loadError is not null)
{
    <MessageBox Type="danger" Message="@loadError" />
}
else if (borrador is null)
{
    <div class="rounded-2xl border border-slate-200 bg-white px-8 py-12 text-center text-slate-400 shadow-sm">
        <p class="font-semibold text-slate-500">No se encontró la factura en preparación (puede haberse registrado o descartado).</p>
        <p class="mt-2 text-sm"><a class="underline" href="/facturas-venta">Ver las facturas registradas</a></p>
    </div>
}
else
{
    @if (EsPosteada)
    {
        <DocumentoAvisoPosteado Documento="la factura" Numero="@(borrador.FacturaVentaNumero ?? string.Empty)" Href="@FacturaHref" />
    }
    @if (borrador.Estado == EstadoFacturaBorrador.Liberada)
    {
        @* Documento heredado (versión anterior, "Liberar"): se registra tal cual o se vuelve a editar. Nunca se ofrece para Abierta. *@
        <div class="mb-6" data-testid="aviso-liberada">
            <MessageBox Type="warning" Message="Esta factura quedó lista para registrar en la versión anterior: puede registrarla tal cual o volver a editarla." />
            @if (canModify)
            {
                <div class="mt-3 flex flex-wrap items-center gap-3">
                    <a href="@BuildUrl(registrar: true)" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Registrar factura</a>
                    <EditForm Model="ReabrirInput" FormName="reabrir" OnValidSubmit="ReabrirAsync">
                        <button type="submit" data-testid="volver-a-editar" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Volver a editar</button>
                    </EditForm>
                </div>
            }
        </div>
    }

    <!-- ── Cabecera ── -->
    <DocumentoCabeceraEditable Model="UpdateInput" FormName="guardar-cabecera" OnValidSubmit="GuardarCabeceraAsync"
                               Mostrar="MuestraFormCabecera" CargaFallida="false" Botones="@BotonesCabecera">
        <input type="hidden" name="UpdateInput.Xmin" value="@UpdateInput!.Xmin" />
        <DatosDerivados Datos="@DatosCliente" DetallesContables="@DetallesContables" />
        <NumeracionRegistro Codigo="@borrador.SerieRegistroCodigo" Proximo="@proximo" PuedeCambiar="@esAdministrador"
                            Id="UpdateInput_SerieRegistroId" Name="UpdateInput.SerieRegistroId" Series="@seriesRegistro.Items"
                            Seleccion="@UpdateInput.SerieRegistroId" VigenteId="@borrador.SerieRegistroId" CargaFallida="@seriesRegistro.CargaFallida" />
        <CabeceraFacturaFields Model="UpdateInput" Prefix="UpdateInput" />
    </DocumentoCabeceraEditable>
    @if (!MuestraFormCabecera)
    {
        <DocumentoCabecera Campos="@CamposCabecera" />
    }

    <!-- ── Líneas ── -->
    @if (EsPosteada)
    {
        <DocumentoLineasLectura TLinea="LineaDocumento" Columnas="ColumnasDocumento.Factura"
                                Lineas="@lineas.OrderBy(x => x.NumeroLinea).Select(LineaDocumento.Desde).ToList()" TextoVacio="La factura no tiene líneas." />
    }
    else
    {
        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
            <div class="px-6 py-4 border-b border-slate-100">
                <h2 class="text-sm font-semibold text-slate-700">Líneas</h2>
                <p class="mt-1 text-xs text-slate-500">@lineas.Count línea(s).</p>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-100 text-sm" data-testid="tabla-lineas">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">#</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Tipo</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Producto / Cuenta</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Descripción</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Almacén</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Cantidad</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Precio</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Desc. %</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Importe</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">IVA</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50 bg-white">
                        @if (lineas.Count == 0)
                        {
                            <tr><td colspan="@ColumnasTabla" class="px-4 py-8 text-center text-slate-400 text-sm">@(MuestraFilaNueva ? "La factura todavía no tiene líneas: agréguelas en la última fila." : "La factura no tiene líneas.")</td></tr>
                        }
                        @foreach (var (l, i) in lineas.OrderBy(x => x.NumeroLinea).Select((l, i) => (l, i)))
                        {
                            if (EditaLineaEnFila && EditLineaId == l.Id)
                            {
                                <DocumentoFilaFormulario @key="l.Id" Variante="VarianteFilaFormulario.Edicion" Columnas="@ColumnasTabla">
                                    @ContenidoEdicionLinea
                                </DocumentoFilaFormulario>
                                continue;
                            }

                            <tr @key="l.Id" id="linea-@l.NumeroLinea" class="hover:bg-slate-50">
                                <td class="px-4 py-3 text-slate-400 text-xs">@l.NumeroLinea</td>
                                <td class="px-4 py-3 text-xs text-slate-700">@VentasOpciones.TipoLinea(l.Tipo)</td>
                                <td class="px-4 py-3 text-xs text-slate-700">@(l.ProductoCodigo ?? l.CuentaContableNumero ?? "—")</td>
                                <td class="px-4 py-3 text-slate-700">@l.Descripcion</td>
                                <td class="px-4 py-3 text-xs text-slate-500">@(l.AlmacenCodigo ?? "—")</td>
                                @if (l.Tipo == TipoLineaFactura.Comentario)
                                {
                                    <td colspan="5"></td>
                                }
                                else
                                {
                                    <td class="px-4 py-3 text-right text-slate-700">@Cantidad(l.Cantidad) <span class="text-xs text-slate-400">@l.UnidadMedidaCodigo</span></td>
                                    <td class="px-4 py-3 text-right text-slate-700">@l.PrecioUnitario.ToString("0.00##", CultureInfo.InvariantCulture)</td>
                                    <td class="px-4 py-3 text-right text-slate-500">@(l.PorcentajeDescuentoLinea == 0 ? "—" : l.PorcentajeDescuentoLinea.ToString("0.#####", CultureInfo.InvariantCulture))</td>
                                    <td class="px-4 py-3 text-right font-semibold text-slate-800">@VentasOpciones.Importe(l.ImporteLinea)</td>
                                    <td class="px-4 py-3 text-xs text-slate-500">@l.IdentificadorIva @(l.PorcentajeIva.ToString("0.##", CultureInfo.InvariantCulture))%</td>
                                }
                                <td class="px-4 py-3 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (canModify && Abierta)
                                        {
                                            <a href="@BuildUrl(editLineaId: l.Id)" class="btn-press rounded-lg border border-amber-200 bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-700 hover:bg-amber-100" title="Modificar línea" aria-label="@($"Modificar línea {i + 1}")">Modificar</a>
                                        }
                                        @if (canDelete && Abierta)
                                        {
                                            <a href="@BuildUrl(deleteLineaId: l.Id)" class="btn-press rounded-lg border border-red-200 bg-red-50 px-2 py-1 text-xs font-semibold text-red-700 hover:bg-red-100" title="Eliminar línea" aria-label="@($"Eliminar línea {i + 1}")">Eliminar</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (EditaLineaEnFila && EditLineaId is { } editada && lineas.All(x => x.Id != editada))
                        {
                            @* La línea a modificar no está en la lista (borrada por otro usuario): su fila de edición muestra el aviso. *@
                            <DocumentoFilaFormulario Variante="VarianteFilaFormulario.Edicion" Columnas="@ColumnasTabla">
                                @ContenidoEdicionLinea
                            </DocumentoFilaFormulario>
                        }
                        @if (MuestraFilaNueva)
                        {
                            <DocumentoFilaFormulario Columnas="@ColumnasTabla">
                                @ContenidoAltaLinea
                            </DocumentoFilaFormulario>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ── Totales ── -->
    <DocumentoTotales Totales="@(totales is null ? null : TotalesDocumento.Desde(totales, lineas.Sum(l => l.ImporteDescuentoLinea)))"
                      Titulo="@(EsPosteada ? "Totales" : "Totales (vista previa)")" />

    @if (MuestraDialogoPosteo)
    {
        <ConfirmarRegistro Titulo="Registrar factura" Aviso="Se descontará el inventario y se generará el asiento; no se puede deshacer."
                           Resumen="@ResumenRegistro" Model="PostearInput" FormName="confirm-postear" OnValidSubmit="PostearAsync"
                           SeguirEditandoHref="@UrlPropia">
            <Errores>
                @if (posteoError is not null)
                {
                    <div data-testid="errores-posteo"><ResumenErrores Mensaje="@posteoError" Errores="@ErroresPosteo" /></div>
                }
            </Errores>
        </ConfirmarRegistro>
    }

    @if (MuestraDialogoBorrarLinea)
    {
        <ConfirmDialog Title="Confirmar eliminación" Message="Esta acción quitará la línea seleccionada de la factura." Variant="danger" CancelHref="@UrlPropia">
            <p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-900">@(lineaAEliminar is null ? DeleteLineaId?.ToString() : $"Línea {lineaAEliminar.NumeroLinea} — {VentasOpciones.TipoLinea(lineaAEliminar.Tipo)}: {lineaAEliminar.Descripcion}")</p>
            <EditForm Model="DeleteInputLinea" FormName="delete-linea" OnValidSubmit="DeleteLineaAsync" class="mt-4">
                <input type="hidden" name="DeleteInputLinea.Id" value="@DeleteLineaId" />
                <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">Sí, eliminar</button>
                <a href="@UrlPropia" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
            </EditForm>
        </ConfirmDialog>
    }

    @if (MuestraDialogoEliminar)
    {
        <ConfirmDialog Title="Descartar factura" Message="Se descartará la factura en preparación con todas sus líneas. No se puede deshacer." Variant="danger" CancelHref="@UrlPropia">
            <EditForm Model="DeleteInput" FormName="delete-borrador" OnValidSubmit="EliminarBorradorAsync" class="mt-4">
                <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">Sí, descartar</button>
                <a href="@UrlPropia" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
            </EditForm>
        </ConfirmDialog>
    }
}

@* Formularios de acción que el estado (borrador posteado/eliminado/liberado, línea borrada) o el permiso ya no dejan mostrar:
   se mantiene en el árbol un EditForm vacío con el MISMO FormName y handler, para que un POST obsoleto, doble o forzado llegue
   al handler y reciba el mensaje real (404/409/400/403 de la API o el de la guarda) en vez del 400 genérico de Blazor
   ("Cannot submit the form…"). La autorización real la hace la API. guardar-cabecera lo mantiene DocumentoCabeceraEditable
   (Mostrar=false) mientras haya borrador; sin borrador, va aquí. *@
@if (borrador is null)
{
    <EditForm Model="UpdateInput" FormName="guardar-cabecera" OnValidSubmit="GuardarCabeceraAsync"></EditForm>
}
@if (!MuestraFormAgregar)
{
    <EditForm Model="AddInput" FormName="add-linea" OnValidSubmit="CreateLineaAsync"></EditForm>
}
@if (!MuestraFormModificar)
{
    <EditForm Model="UpdateInputLinea" FormName="update-linea" OnValidSubmit="UpdateLineaAsync"></EditForm>
}
@* "liberar" ya no tiene botón (spec alta rápida): vacío SIEMPRE, por una pestaña abierta de la versión anterior. *@
<EditForm Model="LiberarInput" FormName="liberar" OnValidSubmit="LiberarAsync"></EditForm>
@if (!MuestraReabrir)
{
    <EditForm Model="ReabrirInput" FormName="reabrir" OnValidSubmit="ReabrirAsync"></EditForm>
}
@if (!MuestraDialogoPosteo)
{
    <EditForm Model="PostearInput" FormName="confirm-postear" OnValidSubmit="PostearAsync"></EditForm>
}
@if (!MuestraDialogoBorrarLinea)
{
    <EditForm Model="DeleteInputLinea" FormName="delete-linea" OnValidSubmit="DeleteLineaAsync"></EditForm>
}
@if (!MuestraDialogoEliminar)
{
    <EditForm Model="DeleteInput" FormName="delete-borrador" OnValidSubmit="EliminarBorradorAsync"></EditForm>
}

@code {
    private const string BorradorNoDisponible = "No se encontró la factura en preparación: puede haberse registrado o descartado por otro usuario.";
    /// <summary>Guarda de los POST sin borrador: si la carga falló (loadError) no se sabe si existe, así que se pide recargar.</summary>
    private string BorradorNoCargado => loadError is null ? BorradorNoDisponible : "No fue posible cargar la factura en preparación; recargue la página.";

    [Parameter] public Guid BorradorId { get; set; }

    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }
    // [SupplyParameterFromQuery] no admite enums: el tipo de línea viaja como entero (1 Producto, 2 CuentaContable, 3 Comentario).
    [SupplyParameterFromQuery(Name = "tipo")] private int? TipoQuery { get; set; }
    [SupplyParameterFromQuery(Name = "addProductoQuery")] private string? AddProductoQuery { get; set; }
    [SupplyParameterFromQuery(Name = "addProductoId")] private Guid? AddProductoId { get; set; }
    [SupplyParameterFromQuery(Name = "editLineaId")] private Guid? EditLineaId { get; set; }
    [SupplyParameterFromQuery(Name = "editProductoQuery")] private string? EditProductoQuery { get; set; }
    [SupplyParameterFromQuery(Name = "editProductoId")] private Guid? EditProductoIdOverride { get; set; }
    [SupplyParameterFromQuery(Name = "editBuscar")] private bool EditBuscarProducto { get; set; }
    [SupplyParameterFromQuery(Name = "deleteLineaId")] private Guid? DeleteLineaId { get; set; }
    [SupplyParameterFromQuery(Name = "registrar")] private bool RegistrarConfirm { get; set; }
    // Enlaces de la versión anterior (?postear=true) siguen abriendo la confirmación.
    [SupplyParameterFromQuery(Name = "postear")] private bool PostearLegado { get; set; }
    [SupplyParameterFromQuery(Name = "eliminar")] private bool EliminarConfirm { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm(FormName = "add-linea")] private LineaFacturaForm? AddInput { get; set; }
    [SupplyParameterFromForm(FormName = "update-linea")] private LineaFacturaForm? UpdateInputLinea { get; set; }
    [SupplyParameterFromForm(FormName = "delete-linea")] private DeleteLineaForm? DeleteInputLinea { get; set; }
    [SupplyParameterFromForm(FormName = "liberar")] private AccionForm? LiberarInput { get; set; }
    [SupplyParameterFromForm(FormName = "reabrir")] private AccionForm? ReabrirInput { get; set; }
    [SupplyParameterFromForm(FormName = "confirm-postear")] private AccionForm? PostearInput { get; set; }
    [SupplyParameterFromForm(FormName = "guardar-cabecera")] private FacturasVentaBorradores.BorradorForm? UpdateInput { get; set; }
    [SupplyParameterFromForm(FormName = "delete-borrador")] private AccionForm? DeleteInput { get; set; }

    private const int ColumnasTabla = 11;

    private string UrlBase => $"{RutasPreparacion.Factura}/{BorradorId}";

    /// <summary>Esta página sin acciones transitorias, conservando el returnUrl (Cancelar de los diálogos).</summary>
    private string UrlPropia => BuildUrl();

    private string Volver => RetornoLocal.Volver(ReturnUrl, RutasPreparacion.ListaFacturas);

    private string Titulo => borrador is null || !EsPosteada ? "Factura en preparación" : $"Preparación de la factura {borrador.FacturaVentaNumero}";

    private string FacturaHref => borrador?.FacturaVentaNumero is { } numero ? $"/facturas-venta/{Uri.EscapeDataString(numero)}" : "/facturas-venta";

    private IReadOnlyList<Miga> Migas =>
        [new("Facturación", "/modulos/facturacion"), new("Facturas", "/facturas-venta"), new("En preparación", RutasPreparacion.ListaFacturas), new(borrador?.NombreFacturacion ?? "Factura")];

    private IReadOnlyList<DatoDerivado> DatosCliente => borrador is null ? [] :
    [
        new("Vender a", $"{borrador.SocioNegocioCodigo} — {borrador.SocioNegocioNombre}", $"/clientes/{borrador.SocioNegocioId}"),
        new("Facturar a", $"{borrador.SocioNegocioFacturarACodigo} — {borrador.NombreFacturacion}"),
        new("RNC / razón social", DatosDocumento.Fiscal(borrador.RazonSocialFacturacion, borrador.NumeroDocumentoFiscal)),
        new("Término de pago", borrador.TerminoPagoCodigo ?? "Sin término"),
        new("Moneda", borrador.Moneda),
        new("Almacén", borrador.AlmacenCodigo ?? "—"),
    ];

    private IReadOnlyList<DatoDerivado> DetallesContables => borrador is null ? [] :
    [
        new("Grupo de negocio", borrador.GrupoNegocioCodigo ?? "—"),
        new("Grupo de IVA de negocio", borrador.GrupoIvaNegocioCodigo ?? "—"),
        new("Grupo de cliente contable", borrador.GrupoClienteContableCodigo ?? "—"),
    ];

    /// <summary>Resumen de la confirmación de "Registrar factura".</summary>
    private IReadOnlyList<DatoDerivado> ResumenRegistro => borrador is null ? [] :
    [
        new("Total", totales is null ? "—" : VentasOpciones.Importe(totales.ImporteTotal)),
        new("Líneas", lineas.Count.ToString(CultureInfo.InvariantCulture)),
        new("Serie", borrador.SerieRegistroCodigo ?? "—"),
        new("Próximo número", proximo?.Numero ?? "—"),
    ];

    /// <summary>Errores del registro más cualquier otro aviso de la misma petición: un solo resumen de errores a la vez.</summary>
    private IReadOnlyList<string> ErroresPosteo =>
        !string.IsNullOrWhiteSpace(message) && messageType != "success" ? [.. posteoErrores, message, .. errores] : posteoErrores;

    /// <summary>Botones de la tarjeta (BotonesPreparacion, compartido con la nota de crédito).</summary>
    private RenderFragment BotonesCabecera => __builder =>
    {
        <BotonesPreparacion TextoRegistrar="Registrar factura" Prefijo="UpdateInput" Proximo="@proximo" LimpiarHref="@UrlPropia" CancelarHref="@Volver" />
    };

    private IReadOnlyList<AccionPagina> VerDocumento => borrador is null ? [] :
    [
        new("Cliente", IconosModulo.Persona, _ => $"/clientes/{borrador.SocioNegocioId}", ApplicationPolicies.CanConsult, RequiereSeleccion: true),
        new("Movimientos del cliente", IconosModulo.Lista, _ => $"/ventas/movimientos-cliente?socioId={borrador.SocioNegocioFacturarAId}", ApplicationPolicies.CanConsult, RequiereSeleccion: true),
    ];

    /// <summary>Cabecera en solo lectura (Liberada, sin permiso de modificar o Posteada); la serie, con CamposDocumento.Series (contrato S11, I3).</summary>
    private IReadOnlyList<CampoDocumento> CamposCabecera
    {
        get
        {
            if (borrador is null)
            {
                return [];
            }

            var campos = new List<CampoDocumento>
            {
                new("Vender a", $"{borrador.SocioNegocioCodigo} — {borrador.SocioNegocioNombre}", $"/clientes/{borrador.SocioNegocioId}"),
                new("Facturar a", $"{borrador.SocioNegocioFacturarACodigo} — {borrador.NombreFacturacion}", $"/clientes/{borrador.SocioNegocioFacturarAId}",
                    $"{borrador.RazonSocialFacturacion} {borrador.NumeroDocumentoFiscal}".Trim()),
                new("Fechas", $"Reg. {EntradaFecha.Formatear(borrador.FechaRegistro)} · Doc. {EntradaFecha.Formatear(borrador.FechaDocumento)}", null,
                    $"Vence {EntradaFecha.Formatear(borrador.FechaVencimiento)}{(borrador.TerminoPagoCodigo is null ? "" : $" ({borrador.TerminoPagoCodigo})")}"),
                new("Almacén / Moneda", $"{borrador.AlmacenCodigo} · {borrador.Moneda}"),
                CamposDocumento.Series(borrador.SerieRegistroCodigo, EsPosteada ? null : proximo),
            };
            if (EsPosteada && borrador.FacturaVentaNumero is { } factura)
            {
                campos.Add(new("Factura registrada", factura, FacturaHref));
            }

            campos.Add(new("Descripción", string.IsNullOrWhiteSpace(borrador.Descripcion) ? "—" : borrador.Descripcion, Ancho: true));
            return campos;
        }
    }

    private TipoLineaFactura AddTipo => TipoQuery is 2 ? TipoLineaFactura.CuentaContable : TipoQuery is 3 ? TipoLineaFactura.Comentario : TipoLineaFactura.Producto;

    private bool Abierta => borrador?.Estado == EstadoFacturaBorrador.Abierta;

    private bool EsPosteada => borrador?.Estado == EstadoFacturaBorrador.Posteada;

    private bool MuestraFormCabecera => borrador is not null && canModify && Abierta;

    private bool PuedeEliminar => borrador is not null && canDelete && Abierta;

    private bool MuestraDialogoEliminar => EliminarConfirm && PuedeEliminar;

    private bool MuestraFilaNueva => borrador is not null && canAdd && Abierta;

    private bool EditaLineaEnFila => borrador is not null && canModify && Abierta && EditLineaId.HasValue;

    // Qué formularios de acción están visibles (el resto se mantiene vacío en el árbol, ver el final del marcado).
    private bool MuestraFormAgregar => borrador is not null && canAdd && Abierta && !(AddTipo == TipoLineaFactura.Producto && addProducto is null);

    private bool MuestraFormModificar => borrador is not null && canModify && Abierta && EditLineaId.HasValue && lineaAEditar is not null
        && !(lineaAEditar.Tipo == TipoLineaFactura.Producto && editProducto is null);

    private bool MuestraReabrir => borrador is not null && canModify && borrador.Estado == EstadoFacturaBorrador.Liberada;

    private bool MuestraDialogoPosteo => borrador is not null && (RegistrarConfirm || PostearLegado) && canModify && !EsPosteada;

    private bool MuestraDialogoBorrarLinea => borrador is not null && DeleteLineaId.HasValue && canDelete && Abierta;

    private FacturaVentaBorradorResponse? borrador;
    private IReadOnlyList<LineaFacturaVentaBorradorResponse> lineas = [];
    private TotalesFactura? totales;
    private string? loadError;
    private string? message;
    private string messageType = "info";
    private IReadOnlyList<string> errores = [];
    private string? posteoError;
    private IReadOnlyList<string> posteoErrores = [];

    private OpcionesCargadas<AlmacenResponse> almacenes = OpcionesCargadas<AlmacenResponse>.SinCargar;
    private OpcionesCargadas<CuentaContableResponse> cuentas = OpcionesCargadas<CuentaContableResponse>.SinCargar;
    private OpcionesCargadas<GrupoOpcion> gruposIva = OpcionesCargadas<GrupoOpcion>.SinCargar;
    private OpcionesCargadas<SerieResponse> seriesRegistro = OpcionesCargadas<SerieResponse>.SinCargar;
    private ProximoVista? proximo;
    private PermisosPagina? permisos;

    private ProductoResponse? addProducto;
    private IReadOnlyList<ProductoResponse> addProductoOpciones = [];
    private bool addProductoOpcionesCargaFallida;
    private ProductoResponse? editProducto;
    private IReadOnlyList<ProductoResponse> editProductoOpciones = [];
    private bool editProductoOpcionesCargaFallida;
    private LineaFacturaVentaBorradorResponse? lineaAEditar;
    private LineaFacturaVentaBorradorResponse? lineaAEliminar;

    private bool addInputNuevo;
    private bool canAdd;
    private bool canModify;
    private bool canDelete;
    private bool esAdministrador;

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // En un GET el formulario de alta es nuevo; en un POST llega enlazado y no se retoca (el precio vacío debe fallar).
        addInputNuevo = AddInput is null;
        AddInput ??= new() { Tipo = (short)AddTipo, CantidadTexto = AddTipo == TipoLineaFactura.Comentario ? null : "1" };
        UpdateInputLinea ??= new();
        DeleteInputLinea ??= new();
        LiberarInput ??= new();
        ReabrirInput ??= new();
        PostearInput ??= new();
        UpdateInput ??= new();
        DeleteInput ??= new();

        permisos = await PermisosPagina.CargarAsync(AuthorizationService, AuthenticationStateTask);
        (canAdd, canModify, canDelete) = (permisos.CanAdd, permisos.CanModify, permisos.CanDelete);
        esAdministrador = await permisos.PuedeAsync(ApplicationPolicies.CanAdministrar);

        try
        {
            borrador = await FacturaApiClient.GetBorradorAsync(BorradorId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load borrador {Id}.", BorradorId);
            loadError = "No fue posible cargar la factura en preparación.";
            return;
        }

        if (borrador is null)
        {
            return;
        }

        try
        {
            lineas = await FacturaApiClient.ListLineasAsync(BorradorId) ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load líneas of borrador {Id}.", BorradorId);
            Show("danger", "No fue posible cargar las líneas de la factura.");
        }

        try
        {
            totales = await FacturaApiClient.GetTotalesAsync(BorradorId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load totales of borrador {Id}.", BorradorId);
        }

        if (!EsPosteada)
        {
            // Vista previa del próximo número de la serie de registro (sin reserva, NS15); un fallo se muestra junto a la serie.
            proximo = await SeriesOpciones.ProximoAsync(SerieApiClient, borrador.SerieRegistroId, Logger);
        }

        if (Ok is not null)
        {
            (messageType, message) = Ok switch
            {
                "creado" => ("success", "Factura en preparación. Agregue sus líneas."),
                "copiado" => ("success", "Factura en preparación creada desde la factura registrada. Revise las líneas y regístrela."),
                "modificado" => ("success", "Cambios guardados."),
                "linea_creada" => ("success", "Línea agregada satisfactoriamente."),
                "linea_modificada" => ("success", "Línea modificada satisfactoriamente."),
                "linea_eliminada" => ("success", "Línea eliminada satisfactoriamente."),
                "reabierto" => ("success", "La factura volvió a edición."),
                _ => ("info", null)
            };
        }

        if (Abierta && (canAdd || canModify))
        {
            almacenes = await VentasOpciones.AlmacenesAsync(AlmacenApiClient, Logger);
            cuentas = await VentasOpciones.CuentasCapturaDirectaAsync(CuentaApiClient, Logger);
            gruposIva = await VentasOpciones.GruposIvaProductoAsync(GrupoApiClient, Logger);
        }

        if (MuestraFormCabecera)
        {
            // "Cambiar serie de registro" solo para el Administrador (spec alta rápida, Parte 1.4).
            if (esAdministrador)
            {
                seriesRegistro = await SeriesOpciones.ActivasAsync(SerieApiClient, TipoDocumentoSerie.FacturaVenta, Logger);
            }

            // Solo se rellena con lo guardado cuando NO llegó el formulario de la cabecera (Xmin = 0).
            if (UpdateInput.Xmin == 0)
            {
                UpdateInput.FechaRegistroTexto = EntradaFecha.Formatear(borrador.FechaRegistro);
                UpdateInput.FechaDocumentoTexto = EntradaFecha.Formatear(borrador.FechaDocumento);
                UpdateInput.FechaVencimientoTexto = EntradaFecha.Formatear(borrador.FechaVencimiento);
                UpdateInput.Descripcion = borrador.Descripcion;
                UpdateInput.SerieRegistroId = esAdministrador ? borrador.SerieRegistroId : null;
                UpdateInput.Xmin = borrador.Xmin;
            }
        }

        if (DeleteLineaId.HasValue && canDelete)
        {
            lineaAEliminar = lineas.FirstOrDefault(x => x.Id == DeleteLineaId.Value);
        }

        if (EditLineaId.HasValue)
        {
            lineaAEditar = lineas.FirstOrDefault(x => x.Id == EditLineaId.Value);
            if (lineaAEditar is null)
            {
                try { lineaAEditar = await FacturaApiClient.GetLineaAsync(EditLineaId.Value); }
                catch (Exception ex) { Logger.LogWarning(ex, "Could not load línea {Id}.", EditLineaId); }
            }

            // Solo se rellena con lo guardado cuando NO llegó un formulario de modificación (Xmin = 0).
            if (lineaAEditar is not null && UpdateInputLinea.Xmin == 0)
            {
                UpdateInputLinea.Tipo = (short)lineaAEditar.Tipo;
                UpdateInputLinea.AlmacenId = lineaAEditar.AlmacenId;
                UpdateInputLinea.CuentaContableId = lineaAEditar.CuentaContableId;
                UpdateInputLinea.GrupoIvaProductoId = lineaAEditar.Tipo == TipoLineaFactura.CuentaContable ? lineaAEditar.GrupoIvaProductoId : null;
                UpdateInputLinea.CantidadTexto = lineaAEditar.Tipo == TipoLineaFactura.Comentario ? null : Cantidad(lineaAEditar.Cantidad);
                UpdateInputLinea.PrecioUnitarioTexto = lineaAEditar.Tipo == TipoLineaFactura.Comentario ? null : lineaAEditar.PrecioUnitario.ToString("0.00##", CultureInfo.InvariantCulture);
                UpdateInputLinea.PorcentajeDescuentoTexto = lineaAEditar.PorcentajeDescuentoLinea == 0 ? null : lineaAEditar.PorcentajeDescuentoLinea.ToString("0.#####", CultureInfo.InvariantCulture);
                UpdateInputLinea.Descripcion = lineaAEditar.Descripcion;
                UpdateInputLinea.Xmin = lineaAEditar.Xmin;
            }
        }

        if (Abierta && AddTipo == TipoLineaFactura.Producto)
        {
            await CargarProductoAgregarAsync();
        }

        if (Abierta && lineaAEditar?.Tipo == TipoLineaFactura.Producto)
        {
            await CargarProductoEditarAsync();
        }
    }

    private async Task CargarProductoAgregarAsync()
    {
        if (AddProductoId is { } id)
        {
            try { addProducto = await ProductoApiClient.GetByIdAsync(id); }
            catch (Exception ex) { Logger.LogWarning(ex, "Could not load producto {Id}.", id); }
            if (addProducto is not null)
            {
                // El precio es obligatorio (Task 8.4): se propone el precio de venta (unidad base) si es mayor que cero.
                if (addInputNuevo && addProducto.PrecioVenta > 0 && string.IsNullOrWhiteSpace(AddInput!.PrecioUnitarioTexto))
                {
                    AddInput.PrecioUnitarioTexto = addProducto.PrecioVenta.ToString("0.00##", CultureInfo.InvariantCulture);
                }

                return;
            }
        }

        (addProductoOpciones, addProductoOpcionesCargaFallida) = await BuscarProductosAsync(AddProductoQuery);
    }

    private async Task CargarProductoEditarAsync()
    {
        if (EditProductoIdOverride is null && !EditBuscarProducto)
        {
            // Por defecto se conserva el producto guardado en la línea (sus datos básicos ya vienen en la respuesta).
            editProducto = new ProductoResponse
            {
                Id = lineaAEditar!.ProductoId ?? Guid.Empty,
                Codigo = lineaAEditar.ProductoCodigo ?? string.Empty,
                UnidadMedidaBaseId = lineaAEditar.UnidadMedidaId ?? Guid.Empty,
                UnidadMedidaCodigo = lineaAEditar.UnidadMedidaCodigo ?? string.Empty,
            };
            return;
        }

        if (EditProductoIdOverride is { } id)
        {
            try { editProducto = await ProductoApiClient.GetByIdAsync(id); }
            catch (Exception ex) { Logger.LogWarning(ex, "Could not load producto {Id}.", id); }
            if (editProducto is not null) return;
        }

        (editProductoOpciones, editProductoOpcionesCargaFallida) = await BuscarProductosAsync(EditProductoQuery);
    }

    private async Task<(IReadOnlyList<ProductoResponse>, bool)> BuscarProductosAsync(string? termino)
    {
        try
        {
            var filtro = new ProductoSearchFilter(null, EmptyAsNull(termino), null, null, null, null, null, null);
            var pagina = await ProductoApiClient.ListAsync(filtro, new PageRequest(1, 20, "Nombre", Descendente: false));
            return (pagina.Items, false);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load productos.");
            return ([], true);
        }
    }

    private bool OpcionesFallidas(TipoLineaFactura tipo) => tipo switch
    {
        TipoLineaFactura.Producto => almacenes.CargaFallida,
        TipoLineaFactura.CuentaContable => cuentas.CargaFallida || gruposIva.CargaFallida,
        _ => false
    };

