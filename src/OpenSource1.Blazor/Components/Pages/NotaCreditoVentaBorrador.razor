    // Qué formularios de acción están visibles (el resto se mantiene vacío en el árbol, ver el final del marcado).
    private bool MuestraFormCabecera => borrador is not null && canModify && !EsPosteada;

    private bool MuestraFormAgregar => borrador is not null && canAdd && !EsPosteada && AddLineaId.HasValue && lineaAAgregar is not null;

    private bool MuestraFormModificar => borrador is not null && canModify && !EsPosteada && EditLineaId.HasValue && lineaAEditar is not null;

    private bool MuestraDialogoPosteo => borrador is not null && (RegistrarConfirm || PostearLegado) && canModify && !EsPosteada;

    private bool MuestraDialogoBorrarLinea => borrador is not null && DeleteLineaId.HasValue && canDelete && !EsPosteada;

    private bool PuedeEliminar => borrador is not null && canDelete && !EsPosteada;

