@page "/reporteria"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Reportería – AxionERP</PageTitle>

<a href="/reporteria/empresarial" class="inline-flex rounded-lg bg-brand-600 px-4 py-3 text-white font-semibold mb-6">Reportes empresariales: ventas, inventario, productos más vendidos y cuentas por cobrar</a>

<div class="mb-6">
    <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Reportería</p>
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight dark:text-slate-100">Reportes históricos</h1>
    <p class="text-sm text-slate-500 mt-1 dark:text-slate-400">Genere reportes PDF de clientes o productos aplicando filtros previos, o descargue el dato crudo completo para análisis externo (Power BI, Excel avanzado, etc.).</p>
</div>

<div class="mb-6 flex flex-wrap items-center gap-3">
    <a href="/reports/clientes/raw.xlsx" title="Todos los clientes, todos los campos, sin filtros" class="btn-press inline-flex items-center gap-2 rounded-lg border border-green-200 bg-green-50 px-4 py-2 text-sm font-semibold text-green-700 shadow-sm hover:bg-green-100 dark:border-green-500/30 dark:bg-green-500/10 dark:text-green-400 dark:hover:bg-green-500/20">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
        Excel crudo de clientes
    </a>
    <a href="/reports/productos/raw.xlsx" title="Todos los productos, todos los campos, sin filtros" class="btn-press inline-flex items-center gap-2 rounded-lg border border-green-200 bg-green-50 px-4 py-2 text-sm font-semibold text-green-700 shadow-sm hover:bg-green-100 dark:border-green-500/30 dark:bg-green-500/10 dark:text-green-400 dark:hover:bg-green-500/20">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
        Excel crudo de productos
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6"><MessageBox Type="@messageType" Message="@message" /></div>
}

<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden max-w-5xl dark:border-slate-700 dark:bg-slate-800">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50 dark:border-slate-700/60 dark:bg-slate-900/40"><h2 class="text-sm font-bold text-slate-800 uppercase tracking-wide dark:text-slate-200">Generador de reportes</h2></div>
    <div class="p-6">
        <form method="get" action="/reporteria" data-enhance class="mb-6 flex items-end gap-4">
            <div class="w-full max-w-sm"><label class="block text-sm font-semibold text-slate-700 mb-1.5 dark:text-slate-300">Entidad</label><select name="entity" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200"><option value="clientes" selected="@(Entity == "clientes")">Clientes</option><option value="productos" selected="@(Entity == "productos")">Productos</option></select></div>
            <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Cambiar</button>
        </form>
        @if (Entity == "productos")
        {
            <form method="post" action="/reports/productos/history" class="space-y-5"><AntiforgeryToken /><div class="grid grid-cols-1 md:grid-cols-1 gap-4"><div><label class="block text-sm font-semibold text-slate-700 mb-1.5 dark:text-slate-300">Existencia</label><select name="StockState" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200"><option value="all">Todos</option><option value="with">Con existencia</option><option value="without">Sin existencia</option></select></div></div><div class="flex items-center gap-3"><button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Generar PDF de productos</button><button type="submit" formaction="/reports/productos/history.xlsx" class="btn-press rounded-lg border border-green-200 bg-green-50 px-4 py-2.5 text-sm font-semibold text-green-700 hover:bg-green-100">Exportar Excel</button></div></form>
        }
        else
        {
            <form method="post" action="/reports/clientes/history" class="space-y-5"><AntiforgeryToken /><div class="grid grid-cols-1 md:grid-cols-1 gap-4"><div><label class="block text-sm font-semibold text-slate-700 mb-1.5 dark:text-slate-300">Estado</label><select name="Status" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200"><option value="all">Todos</option><option value="active">Activos</option><option value="inactive">Inactivos</option></select></div></div><div class="flex items-center gap-3"><button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Generar PDF de clientes</button><button type="submit" formaction="/reports/clientes/history.xlsx" class="btn-press rounded-lg border border-green-200 bg-green-50 px-4 py-2.5 text-sm font-semibold text-green-700 hover:bg-green-100">Exportar Excel</button></div></form>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "entity")] private string? Entity { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }
    private string? message; private string messageType = "warning";
    protected override void OnInitialized(){Entity ??= "clientes"; if(Ok=="report-no-data") message = "No hay datos para generar el reporte solicitado.";}
}
